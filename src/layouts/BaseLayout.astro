---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  lang: 'en' | 'fr';
  title: string;
  description?: string;
}

const { lang, title, description = 'Vera Vien — Background Artist, Children\'s Book Illustrator & 2D Artist based in Montréal.' } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Vera Vien</title>
    <meta name="description" content={description} />

    <!-- SEO -->
    <meta name="keywords" content="Vera Vien, Vera Vien portfolio, Background Artist Montreal, 2D Artist Montreal, Children's Book Illustrator, Layout Artist, Animation Portfolio, Illustration Portfolio" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

    <!-- Open Graph -->
    <meta property="og:title" content={`${title} — Vera Vien`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/assets/images/og-cover.jpg" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Young+Serif&family=Work+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Caveat:wght@500;700&family=Special+Elite&family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..700&family=Alfa+Slab+One&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
