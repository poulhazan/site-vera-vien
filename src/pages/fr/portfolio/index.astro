---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import i18n from '../../../data/i18n.json';
import { getCollection } from 'astro:content';

const lang = 'fr';
const t = (i18n as any)[lang];
const projects = (await getCollection('projects', ({ data }) => data.language === lang))
  .sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout lang={lang} title={t.portfolio.title}>
  <div class="masthead-wrap">
    <div class="masthead paper-card">
      <div class="masthead-rule kicker-row">{t.portfolio.editionLabel} · {String(projects.length).padStart(2, '0')} {t.portfolio.worksCount}</div>
      <h1>{t.portfolio.title}</h1>
      <p class="sub">Background, illustration jeunesse, layout, visdev, character design</p>
    </div>
  </div>

  <section class="filters">
    {t.portfolio.filters.map((f: string, i: number) => (
      <button class:list={["chip-btn", { active: i === 0 }]} data-filter={f}>{f}</button>
    ))}
  </section>

  <section class="toc">
    <div class="toc-head">
      <span class="toc-kicker">In this issue</span>
      <span class="toc-count">{projects.length} œuvres à la une</span>
    </div>

    {projects.map((p, i) => (
      <a
        class="toc-row"
        href={`/${lang}/portfolio/${p.data.projectSlug}/`}
        data-categories={[p.data.category, ...p.data.tags].join('|').toLowerCase()}
      >
        <span class="num">{String(i + 1).padStart(2, '0')}</span>
        <div class="thumb" style={`background-image:url(${p.data.thumbImage || p.data.coverImage});background-position:${p.data.thumbPosition}`}></div>
        <div class="info">
          <div class="title">{p.data.title}</div>
          <div class="cat">{p.data.category} <span class="dim">— {p.data.role}</span></div>
        </div>
        <span class="view">{t.portfolio.viewProject}</span>
      </a>
    ))}
  </section>
</BaseLayout>

<style>
  .masthead-wrap { padding: 44px 64px 8px; max-width: 1180px; margin: 0 auto; }
  .masthead {
    padding: 66px 40px 70px;
    box-shadow: 0 2px 0 rgba(40,25,10,.12);
    background-image: url('/assets/images/textures/paper-banner-torn-02.png');
    background-size: cover;
    background-position: 50% 15%;
    background-repeat: no-repeat;
  }
  .kicker-row { font: 700 10.5px 'Work Sans', sans-serif; color: var(--brown-muted); letter-spacing: .16em; text-transform: uppercase; }
  h1 { font-family: 'Fraunces', serif; font-optical-sizing: auto; font-weight: 600; font-size: 66px; line-height: .95; letter-spacing: -.01em; margin-top: 14px; }
  .sub { font: 400 13px 'Work Sans', sans-serif; color: var(--brown-soft); margin-top: 6px; }

  .filters { display: flex; flex-wrap: wrap; gap: 10px; padding: 24px 64px 8px; max-width: 1180px; margin: 0 auto; }
  .chip-btn { font: 500 13px 'Work Sans', sans-serif; padding: 9px 18px; border-radius: 999px; border: none; cursor: pointer; background: var(--chip-bg); color: var(--ink); }
  .chip-btn.active { font-weight: 600; background: var(--ink); color: #FBF3E4; }

  .toc { padding: 8px 64px 72px; max-width: 1180px; margin: 0 auto; }
  .toc-head { display: flex; align-items: baseline; justify-content: space-between; border-top: 3px double var(--rule); border-bottom: 1px solid var(--rule); padding: 8px 0 10px; margin-bottom: 6px; }
  .toc-kicker { font: 700 11px 'Work Sans', sans-serif; color: var(--brown-muted); letter-spacing: .16em; text-transform: uppercase; }
  .toc-count { font: italic 400 12.5px Georgia, serif; color: var(--brown-soft); }

  .toc-row { display: grid; grid-template-columns: 56px 90px 1fr auto; gap: 22px; align-items: center; padding: 20px 0; border-bottom: 1px solid rgba(42,26,12,.18); text-decoration: none; }
  .toc-row:hover .title { color: var(--orange-text); }
  .num { font-family: 'Fraunces', serif; font-style: italic; font-weight: 500; font-size: 26px; color: var(--orange); }
  .thumb { width: 90px; height: 90px; background-color: #EFDFC9; background-size: cover; background-position: center; }
  .title { font-family: 'Fraunces', serif; font-optical-sizing: auto; font-weight: 600; font-size: 24px; color: var(--ink); transition: color .15s ease; }
  .cat { font: 500 12.5px 'Work Sans', sans-serif; color: var(--brown-soft); margin-top: 2px; }
  .cat .dim { color: var(--brown-muted); }
  .view { font: 600 13px 'Work Sans', sans-serif; color: var(--orange-text); white-space: nowrap; }

  @media (max-width: 720px) {
    .masthead-wrap, .filters, .toc { padding-left: 20px; padding-right: 20px; }
    h1 { font-size: 44px; }
    .toc-row { grid-template-columns: 40px 64px 1fr; gap: 14px; }
    .view { display: none; }
    .thumb { width: 64px; height: 64px; }
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.chip-btn');
  const rows = document.querySelectorAll<HTMLAnchorElement>('.toc-row');
  buttons.forEach((btn) => btn.addEventListener('click', () => {
    buttons.forEach((b) => b.classList.remove('active'));
    btn.classList.add('active');
    const filter = (btn.dataset.filter || '').toLowerCase();
    const isAll = btn === buttons[0];
    rows.forEach((row) => {
      const cats = row.dataset.categories || '';
      row.style.display = isAll || cats.includes(filter) ? '' : 'none';
    });
  }));
</script>
