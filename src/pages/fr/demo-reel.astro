---
import BaseLayout from '../../layouts/BaseLayout.astro';
import i18n from '../../data/i18n.json';
import site from '../../data/site.json';

const lang = 'fr';
const t = (i18n as any)[lang];

function youtubeEmbedUrl(url?: string) {
  if (!url) return null;
  const match = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/))([\w-]{11})/);
  return match ? `https://www.youtube.com/embed/${match[1]}` : null;
}
const embedUrl = youtubeEmbedUrl(site.demoReelUrl);
---
<BaseLayout lang={lang} title={t.reel.title}>
  <section class="container article-wrap">
    <div class="article">
      <div class="masthead-rule kicker-row"><span>{t.reel.kicker}</span></div>
      <h1>{t.reel.title}</h1>

      {embedUrl ? (
        <div class="video-embed">
          <iframe
            src={embedUrl}
            title={t.reel.title}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      ) : (
        <div class="video-slot">
          <div class="play-btn"><span class="triangle"></span></div>
          <span class="video-label">[ demo reel ]</span>
        </div>
      )}

      <div class="two-col">
        <p>{t.reel.text1}</p>
        <div class="divider"></div>
        <p>{t.reel.text2}</p>
      </div>

      <div class="cta-row">
        <a class="btn btn-primary" href={site.demoReelUrl} target="_blank" rel="noopener">{t.reel.ctaArtstation}</a>
        <a class="btn btn-outline" href={`/${lang}/portfolio/`}>{t.reel.ctaPortfolio}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .article-wrap { padding: 56px 24px 64px; }
  .article { padding: 32px 44px 40px; background: var(--chip-bg); border-radius: 4px; }
  .kicker-row { font: 700 10.5px 'Work Sans', sans-serif; color: var(--brown-muted); letter-spacing: .16em; text-transform: uppercase; }
  h1 { font-family: 'Fraunces', serif; font-optical-sizing: auto; font-weight: 600; font-size: 46px; line-height: 1; letter-spacing: -.01em; margin-top: 14px; }
  .video-slot { margin-top: 22px; background: #1c1714; aspect-ratio: 16/9; display: flex; align-items: center; justify-content: center; position: relative; box-shadow: 0 0 0 1px rgba(40,25,10,.15); }
  .video-embed { margin-top: 22px; aspect-ratio: 16/9; border-radius: 2px; overflow: hidden; box-shadow: 0 0 0 1px rgba(40,25,10,.15); }
  .video-embed iframe { width: 100%; height: 100%; border: 0; }
  .play-btn { width: 76px; height: 76px; border-radius: 50%; background: rgba(251,243,228,.92); display: flex; align-items: center; justify-content: center; }
  .triangle { width: 0; height: 0; border-top: 15px solid transparent; border-bottom: 15px solid transparent; border-left: 24px solid var(--orange); margin-left: 4px; }
  .video-label { position: absolute; bottom: 16px; left: 20px; font: 11px ui-monospace, monospace; color: #C9A87E; }
  .two-col { display: grid; grid-template-columns: 1fr 1px 1fr; gap: 24px; margin-top: 26px; font: 400 15px/1.6 Georgia, serif; color: var(--brown); }
  .divider { background: var(--divider); }
  .cta-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }
  @media (max-width: 720px) { .two-col { grid-template-columns: 1fr; } .two-col .divider { display: none; } }
</style>
