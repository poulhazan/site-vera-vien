    .final-gallery > div.wide, .decors-grid.finalgallery .tile.wide { grid-column: span 1; }
    .char-row { flex-direction: column; }
    .char-main { flex: none; aspect-ratio: 16/10; }
    .char-grid-below { grid-template-columns: 1fr; }
    .prev-next { flex-direction: column; gap: 10px; padding: 24px; text-align: center; }
    .lightbox { padding: 16px; }
    .lightbox-nav { width: 42px; height: 42px; font-size: 26px; }
    .lightbox-prev { left: 6px; }
    .lightbox-next { right: 6px; }
  }
</style>

<script>
  const items = Array.from(document.querySelectorAll<HTMLElement>('.lightbox-item'));
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const closeBtn = document.getElementById('lightbox-close');
  const prevBtn = document.getElementById('lightbox-prev');
  const nextBtn = document.getElementById('lightbox-next');
  let lastFocused: HTMLElement | null = null;
  let currentIndex = -1;

  function showIndex(i: number) {
    if (!lightboxImg || items.length === 0) return;
    currentIndex = (i + items.length) % items.length;
    const src = items[currentIndex].dataset.lightboxSrc;
    if (src) lightboxImg.src = src;
  }
  function openLightbox(index: number, trigger: HTMLElement) {
    if (!lightbox) return;
    showIndex(index);
    lightbox.classList.add('open');
    lastFocused = trigger;
  }
  function closeLightbox() {
    if (!lightbox) return;
    lightbox.classList.remove('open');
    lastFocused?.scrollIntoView({ block: 'center', behavior: 'instant' as ScrollBehavior });
  }

  items.forEach((el, i) => {
    el.addEventListener('click', () => openLightbox(i, el));
  });
  prevBtn?.addEventListener('click', (e) => { e.stopPropagation(); showIndex(currentIndex - 1); });
  nextBtn?.addEventListener('click', (e) => { e.stopPropagation(); showIndex(currentIndex + 1); });
  closeBtn?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });
  window.addEventListener('keydown', (e) => {
    if (!lightbox?.classList.contains('open')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') showIndex(currentIndex - 1);
    if (e.key === 'ArrowRight') showIndex(currentIndex + 1);
  });

  const autoplayVideos = Array.from(document.querySelectorAll<HTMLVideoElement>('.research-video'));
  if (autoplayVideos.length > 0) {
    const videoObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const video = entry.target as HTMLVideoElement;
        if (entry.isIntersecting) video.play().catch(() => {});
        else video.pause();
      });
    }, { threshold: 0.5 });
    autoplayVideos.forEach((v) => videoObserver.observe(v));
  }
</script>
