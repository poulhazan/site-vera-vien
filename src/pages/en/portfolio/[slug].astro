  .final-gallery { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 24px; }
  .final-gallery > div { border-radius: 2px; overflow: hidden; cursor: zoom-in; height: 220px; }
  .final-gallery > div.wide { grid-column: span 2; height: 320px; }
  .final-gallery img { width: 100%; height: 100%; object-fit: cover; }

  .illustrations-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .illustrations-grid > div { aspect-ratio: 1/1; border-radius: 2px; overflow: hidden; cursor: zoom-in; }
  .illustrations-grid img { width: 100%; height: 100%; object-fit: cover; }

  .palettes { display: grid; gap: 24px; }
  .palettes.split { grid-template-columns: 1fr 1fr; }
  .palette-label { font: 600 11px 'Work Sans', sans-serif; color: var(--brown-muted); letter-spacing: .1em; text-transform: uppercase; margin-bottom: 8px; }
  .palette-row { display: flex; gap: 8px; }

  .process { margin-top: 32px; padding: 30px 36px 34px; background-image: none; background-color: var(--chip-bg); border-radius: 4px; }
  .process-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 22px; }
  .process-head span:first-child { font-family: 'Fraunces', serif; font-optical-sizing: auto; font-weight: 600; font-size: 28px; color: var(--ink); }
  .process-grid { display: grid; gap: 20px; }
  .process-grid .lightbox-item { aspect-ratio: 4/3; border-radius: 2px; overflow: hidden; cursor: zoom-in; }
  .process-grid img { width: 100%; height: 100%; object-fit: cover; }
  .fig-caption { font: italic 400 12px Georgia, serif; color: var(--brown-soft); margin-top: 8px; text-align: center; }

  .skills-box { margin-top: 32px; background: var(--chip-bg); border-radius: 4px; padding: 28px 32px; }
  .skills-box h3 { font-size: 22px; margin-bottom: 12px; }
  .skills-box .chip { background: #FFFBF2; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }

  .sidebar { align-self: start; padding: 28px 30px; display: flex; flex-direction: column; gap: 16px; transform: rotate(.6deg); box-shadow: 0 10px 22px rgba(20,10,4,.16); background-image: none; background-color: var(--chip-bg); }
  .field { display: flex; flex-direction: column; gap: 2px; }
