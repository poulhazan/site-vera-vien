---
import BaseLayout from '../../layouts/BaseLayout.astro';
import i18n from '../../data/i18n.json';

const lang = 'en';
const t = (i18n as any)[lang];

const home = {
  editionLeft: 'Since 2018 · independent portfolio',
  editionRight: 'Montréal, QC — 2026 Edition',
  leadTitle: 'A career built on worlds that tell a story',
  lead: 'Warm, narrative backgrounds and characters made for the screen and the printed page.',
  colCultureT: 'Culture',
  colCulture: "Children's illustration, painted backgrounds and colorful retro worlds made for animation.",
  colAvailT: 'Availability',
  colAvail: 'Permanent studio role or freelance work — background, layout, visual development.',
  colContactT: 'Contact',
};

const polaroids = [
  { src: '/assets/images/home/polaroid-01.png', cls: 'p1' },
  { src: '/assets/images/home/polaroid-02.png', cls: 'p2' },
  { src: '/assets/images/home/polaroid-03.png', cls: 'p3' },
  { src: '/assets/images/home/polaroid-04.png', cls: 'p4' },
  { src: '/assets/images/home/polaroid-05.png', cls: 'p5' },
];
---
<BaseLayout lang={lang} title="Home">
  <section class="hero wood-band">
    <div class="hero-stage">
      <!-- Folded newspaper masthead -->
      <article class="newspaper">
        <div class="paper">
          <div class="edition">
            <span>{home.editionLeft}</span><span>{home.editionRight}</span>
          </div>

          <h1 class="masthead-title">{t.home.title}</h1>

          <div class="roles">
            <span>Background Artist</span><em>·</em>
            <span>Children's Illustrator</span><em>·</em>
            <span>2D Artist</span>
          </div>

          <div class="lead-block">
            <h2 class="lead-title">{home.leadTitle}</h2>
            <p class="lead">{home.lead}</p>
          </div>

          <div class="journal-photo">
            <img src="/assets/images/home/journal-hiking.jpg" alt="" loading="lazy" />
          </div>

          <div class="columns">
            <div><b>{home.colCultureT}</b>{home.colCulture}</div>
            <span class="col-rule"></span>
            <div><b>{home.colAvailT}</b>{home.colAvail}</div>
            <span class="col-rule"></span>
            <div><b>{home.colContactT}</b>veravien29@gmail.com<br />ArtStation · Instagram</div>
          </div>

          <div class="cta-frame">
            <a class="btn btn-primary sq" href={`/${lang}/portfolio/`}>{t.home.ctaPortfolio}</a>
            <a class="btn btn-outline sq" href={`/${lang}/demo-reel/`}>{t.home.ctaReel}</a>
            <a class="cta-link" href={`/${lang}/contact/`}>{t.home.ctaContact} →</a>
          </div>
        </div>
      </article>

      <!-- Polaroids scattered on the desk -->
      {polaroids.map((p) => (
        <img class={`polaroid ${p.cls}`} src={p.src} alt="" loading="lazy" />
      ))}
    </div>
  </section>

  <!-- Category strip -->
  <section class="categories">
    {t.home.categories.map((c: string, i: number) => (
      <div class="category-cell">
        <span class="num">{String(i + 1).padStart(2, '0')}</span>
        <span class="label">{c}</span>
      </div>
    ))}
  </section>

  <!-- Availability band -->
  <section class="availability">
    <p>{t.home.availability}</p>
    <a class="btn" href={`/${lang}/contact/`}>{t.home.ctaContact}</a>
  </section>
</BaseLayout>

<style>
  /* ── Hero / desk ── */
  .hero { padding: 0; }
  .hero-stage {
    position: relative;
    max-width: 1240px;
    margin: 0 auto;
    min-height: 480px;
    padding: 60px 56px 340px;
  }

  /* ── Newspaper ── */
  .newspaper {
    position: relative;
    width: 1080px; max-width: 100%;
    transform: perspective(1400px) rotateX(6deg) rotate(-2deg) translateX(-30px);
    transform-origin: top left;
    filter: drop-shadow(0 30px 40px rgba(15,7,3,.55)) drop-shadow(0 4px 3px rgba(15,7,3,.3));
    z-index: 1;
  }
  .paper {
    background-image: url('/assets/images/textures/paper-journal-02.png');
    background-size: 100% 100%;
    background-repeat: no-repeat;
    aspect-ratio: 1200 / 1010;
    box-shadow: 0 0 0 1px rgba(40,25,10,.06);
    display: flex;
    flex-direction: column;
    padding: 10.52% 108px 38px;
  }

  /* ── Layer 1: layout (margins, columns, rules, frames) ── */
  .edition {
    display: flex; justify-content: flex-start; gap: 90px;
    font: 700 13px 'Special Elite', monospace; color: var(--brown-muted);
    letter-spacing: .02em; text-transform: uppercase;
    border-bottom: 1px solid var(--rule); padding: 0 0 6px 0;
    margin: -49px 40px 0 0;
  }
  .roles {
    display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; align-items: center; gap: 6px;
    border-top: 2px solid var(--rule); border-bottom: 2px solid var(--rule);
    margin-top: 10px; margin-right: 40px; padding: 7px 24px 7px 0;
  }
  .roles span { text-align: center; }
  .roles em { color: var(--orange-text); font-style: normal; }

  .lead-block { margin-top: 14px; max-width: 560px; }

  .journal-photo { position: relative; margin-top: 24px; margin-right: 45px; box-shadow: 0 0 0 1px rgba(40,25,10,.15); overflow: hidden; background: #d8cbb0; }
  .journal-photo img {
    width: 100%; height: 260px; object-fit: cover; object-position: center 40%; display: block;
    filter: grayscale(.7) sepia(.3) contrast(1.35) brightness(1.12) saturate(1.3);
    mix-blend-mode: multiply;
  }
  .journal-photo::after {
    content: '';
    position: absolute; inset: 0;
    background-image: url('/assets/images/textures/halftone-dots.png');
    background-size: 4.5px 4.5px;
    mix-blend-mode: multiply;
    opacity: .5;
    pointer-events: none;
  }

  .columns {
    display: grid; grid-template-columns: 1fr 1px 1fr 1px 1fr; gap: 14px;
    margin-top: auto; padding-top: 14px;
  }
  .columns div { display: flex; flex-direction: column; gap: 3px; }
  .col-rule { background: var(--divider); }

  .cta-frame {
    border: 1.5px solid var(--rule); align-self: flex-start;
    display: flex; flex-wrap: wrap; gap: 14px; align-items: center;
    padding: 10px 18px; margin-top: 16px; background: rgba(255,251,242,.4);
  }

  /* ── Layer 2: text (vintage typography) ── */
  .masthead-title {
    font-family: 'Fraunces', serif; font-optical-sizing: auto; font-weight: 600; font-size: 78px; line-height: .85;
    color: #221507; letter-spacing: -.01em; margin: 59px 0 0;
    text-shadow: .5px .5px 0 rgba(60,35,15,.25), -.5px 0 .5px rgba(60,35,15,.12), 1px 1px 1.5px rgba(60,35,15,.08);
  }
  .roles span {
    font: 700 10.5px 'Special Elite', monospace; color: var(--rule);
    letter-spacing: .02em; text-transform: uppercase;
  }
  .lead-title {
    font-family: 'Special Elite', monospace; font-size: 18px; color: #1B1006; line-height: 1.3;
  }
  .lead {
    font-family: 'Special Elite', monospace; font-size: 12px; line-height: 1.55;
    color: #3A2A16; margin-top: 10px;
  }
  .columns {
    font-family: 'Special Elite', monospace; font-size: 11px; line-height: 1.5; color: #2E2013;
  }
  .columns b {
    font-size: 11.5px; letter-spacing: .03em; text-transform: uppercase; color: var(--ink);
  }
  .cta-frame .btn.sq { border-radius: 0; font-family: 'Special Elite', monospace; font-size: 13px; }
  .cta-frame .cta-link {
    font-family: 'Special Elite', monospace; font-size: 12px; color: var(--ink);
    text-decoration: underline; text-underline-offset: 3px;
  }

  /* ── Polaroids ── */
  .polaroid {
    position: absolute; width: 220px; height: auto;
    filter: drop-shadow(0 14px 22px rgba(15,7,3,.5));
  }
  .p1 { left: 880px; top: 100px; width: 400px; transform: rotate(-9deg); z-index: 2; }
  .p2 { left: 1220px; top: 20px; width: 400px; transform: rotate(7deg); z-index: 3; }
  .p3 { left: 1030px; top: 300px; width: 400px; transform: rotate(-4deg); z-index: 2; }
  .p4 { left: 840px; top: 620px; width: 400px; transform: rotate(10deg); z-index: 4; }
  .p5 { left: 1160px; top: 820px; width: 400px; transform: rotate(-12deg); z-index: 3; }

  /* ── Category strip ── */
  .categories { display: grid; grid-template-columns: repeat(4, 1fr); background: var(--orange); }
  .category-cell { padding: 22px; border-right: 2px solid rgba(74,46,24,.35); display: flex; flex-direction: column; gap: 4px; }
  .category-cell:last-child { border-right: none; }
  .num { font: 700 12px ui-monospace, monospace; color: var(--ink); }
  .label { font: 600 15px 'Work Sans', sans-serif; color: var(--ink); }

  /* ── Availability ── */
  .availability { background: #B4642E; padding: 44px 64px; display: flex; align-items: center; justify-content: space-between; gap: 32px; flex-wrap: wrap; }
  .availability p { font-family: 'Fraunces', serif; font-optical-sizing: auto; font-weight: 600; font-size: 26px; color: #FFF3DF; max-width: 720px; line-height: 1.3; margin: 0; }
  .availability .btn { background: #FFF3DF; color: #4A2E18; white-space: nowrap; }

  /* ── Responsive ── */
  @media (max-width: 1180px) {
    .newspaper { width: 100%; transform: none; }
    .polaroid { display: none; }
    .paper { aspect-ratio: auto; background-size: 100% auto; background-position: top center; background-color: var(--paper); }
    .edition { margin-top: 0; }
    .masthead-title { margin-top: 24px; }
  }
  @media (max-width: 620px) {
    .categories { grid-template-columns: repeat(2, 1fr); }
    .paper { padding: 22px 20px; }
    .masthead-title { font-size: 44px; margin-top: 16px; }
    .roles { grid-template-columns: 1fr; gap: 3px; padding: 8px 0; }
    .roles em { display: none; }
    .columns { grid-template-columns: 1fr; margin-top: 16px; }
    .col-rule { display: none; }
  }
</style>
