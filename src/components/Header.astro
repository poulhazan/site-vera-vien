---
import i18n from '../data/i18n.json';

interface Props { lang: 'en' | 'fr' }
const { lang } = Astro.props as Props;
const t = (i18n as any)[lang];
const other = lang === 'en' ? 'fr' : 'en';

// Map current path to the equivalent path in the other language
const path = Astro.url.pathname.replace(/^\/(en|fr)/, `/${other}`);

const isActive = (section: string) => Astro.url.pathname.includes(`/${lang}/${section}`);
---
<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href={`/${lang}/`}>VERAVIEN.CA — PORTFOLIO, VOL. 1</a>
    <button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="main-nav" aria-label={lang === 'fr' ? 'Ouvrir le menu' : 'Open menu'}>
      <span></span><span></span><span></span>
    </button>
    <nav class="main-nav" id="main-nav" aria-label={lang === 'fr' ? 'Navigation principale' : 'Main navigation'}>
      <a href={`/${lang}/portfolio/`} aria-current={isActive('portfolio') ? 'page' : undefined}>{t.nav.portfolio}</a>
      <a href={`/${lang}/sketchbook/`} aria-current={isActive('sketchbook') ? 'page' : undefined}>{t.nav.sketchbook}</a>
      <a href={`/${lang}/demo-reel/`} aria-current={isActive('demo-reel') ? 'page' : undefined}>{t.nav.reel}</a>
      <a href={`/${lang}/about/`} aria-current={isActive('about') ? 'page' : undefined}>{t.nav.about}</a>
      <a href={`/${lang}/contact/`} aria-current={isActive('contact') ? 'page' : undefined}>{t.nav.contact}</a>
      <span class="lang-switch">
        <a href={lang === 'en' ? Astro.url.pathname : path} aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
        <span aria-hidden="true">·</span>
        <a href={lang === 'fr' ? Astro.url.pathname : path} aria-current={lang === 'fr' ? 'true' : undefined}>FR</a>
      </span>
      <a class="btn btn-primary resume-btn" href={`/${lang}/resume/`}>{t.nav.resume}</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--cream);
    border-bottom: 2px solid var(--rule);
    position: sticky;
    top: 0;
    z-index: 20;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 24px;
  }
  .logo {
    font: 700 12px ui-monospace, Menlo, monospace;
    letter-spacing: .14em;
    color: #8A5A33;
    white-space: nowrap;
  }
  .logo:hover { color: #8A5A33; }
  .main-nav {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  .main-nav a { font: 500 14px 'Work Sans', sans-serif; color: var(--ink); }
  .main-nav a:hover { color: var(--orange-text); }
  .main-nav a[aria-current='page'] { font-weight: 600; color: var(--orange-text); border-bottom: 2px solid var(--orange); padding-bottom: 2px; }
  .lang-switch { font: 600 12px 'Work Sans', sans-serif; color: var(--brown-muted); display: flex; gap: 6px; }
  .lang-switch a { color: var(--brown-muted); }
  .lang-switch a[aria-current='true'] { color: var(--orange-text); }
  .resume-btn { padding: 10px 20px; }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 38px; height: 38px;
    border: none; background: transparent; cursor: pointer;
    flex-shrink: 0;
  }
  .nav-toggle span { display: block; width: 22px; height: 2px; background: var(--ink); border-radius: 2px; transition: transform .2s ease, opacity .2s ease; }
  .nav-toggle[aria-expanded='true'] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-toggle[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .nav-toggle[aria-expanded='true'] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 900px) {
    .nav-toggle { display: flex; }
    .main-nav {
      display: none;
      position: absolute;
      top: 100%; left: 0; right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
      background: var(--cream);
      border-bottom: 2px solid var(--rule);
      box-shadow: 0 12px 20px rgba(20,10,4,.12);
      padding: 10px 24px 20px;
    }
    .main-nav.open { display: flex; }
    .main-nav a { width: 100%; padding: 10px 0; }
    .main-nav a[aria-current='page'] { border-bottom: none; border-left: 3px solid var(--orange); padding-left: 10px; }
    .lang-switch { padding: 10px 0; }
    .resume-btn { margin-top: 6px; align-self: flex-start; }
  }
  @media (max-width: 480px) {
    .header-inner { padding: 14px 18px; }
    .logo { font-size: 10.5px; max-width: 60vw; overflow: hidden; text-overflow: ellipsis; }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('main-nav');
  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });
  nav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => {
    nav.classList.remove('open');
    toggle?.setAttribute('aria-expanded', 'false');
  }));
</script>
