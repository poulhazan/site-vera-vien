---
import i18n from '../data/i18n.json';

interface Props {
  lang: 'en' | 'fr';
  project: any; // CollectionEntry<'projects'>
  size?: 'lg' | 'md' | 'sm';
}
const { lang, project, size = 'md' } = Astro.props as Props;
const t = (i18n as any)[lang];
const d = project.data;
---
<a class={`project-card size-${size}`} href={`/${lang}/portfolio/${d.projectSlug}/`}>
  <div class="cover" style={`background-image:url(${d.coverImage})`}></div>
  <div class="meta">
    <div class="title-row">
      <span class="title">{d.title}</span>
      <span class="view">{t.portfolio.viewProject}</span>
    </div>
    <div class="role">{d.category} · {d.role}</div>
    <div class="tags">
      {d.tags.slice(0, 3).map((tag: string) => <span class="chip">{tag}</span>)}
    </div>
  </div>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    background: #FFFDF6;
    box-shadow: 0 8px 18px rgba(20, 10, 4, .14);
    text-decoration: none;
    color: var(--ink);
    height: 100%;
  }
  .cover {
    flex: 1;
    min-height: 160px;
    background-color: #EFDFC9;
    background-size: cover;
    background-position: center;
  }
  .meta { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 6px; }
  .title-row { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
  .title { font-family: 'Fraunces', serif; font-optical-sizing: auto; font-weight: 600; font-size: 19px; color: var(--ink); }
  .view { font: 600 12px 'Work Sans', sans-serif; color: var(--orange-text); white-space: nowrap; }
  .role { font: 500 12px 'Work Sans', sans-serif; color: var(--brown-soft); }
  .tags { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 4px; }
  .size-lg .title { font-size: 23px; }
  .size-lg .cover { min-height: 260px; }
</style>
